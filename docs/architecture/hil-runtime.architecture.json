  "cards": [
    {
      "dot": "cyan",
      "title": "MCP 工具面",
      "items": [
        "四个工具：index_project、get_project_context、search_project_memory、record_project_memory",
        "请求与结构化 Context Package 走同一条 stdio 连接，Harness 按需拉起进程",
        "有意不含 Shell、文件编辑、会话与子代理工具"
      ]
    },
    {
      "dot": "emerald",
      "title": "检索",
      "items": [
        "中文按 2/3 字 n-gram 切分；标识符按蛇形/驼峰词部件匹配",
        "路径按词部件精确匹配（git 不再命中 .github），文件级加成不随窗口体积稀释",
        "片段级评分：命中密度 ÷ token 成本；每文件一个窗口、上限 60 token，互不重叠"
      ]
    },
    {
      "dot": "amber",
      "title": "Phase 3 门槛",
      "items": [
        "中位输入 token 降低 ≥ 20%",
        "Context Recall ≥ 90%；成功率下降 ≤ 2 个百分点",
        "平均重试次数不增加；跨 Harness 记忆复用成功",
        "随机分组记录 seed 与两臂顺序；工具结果体积与 prompt-cache 只记录不设门槛"
      ]
    },
    {
      "dot": "violet",
      "title": "Phase 4 证据门",
      "items": [
        "词法 Recall：hinted 92.3% 已达标，raw 59.3% 未达标 → 可选 Embedding / Reranker（FIRED）",
        "≥ 100 条可比结果 → Model Router（当前 0 条，未触发）",
        "修改质量不可比 → Unified Validator（未举证）",
        "P95 ≥ 1s → 向量存储（当前约 60–80 ms，未触发）"
      ]
    },
    {
      "dot": "rose",
      "title": "验证与证据层",
      "items": [
        "benchmarks/measure.py 逐题机械测量；verify.py 跑回归门与不变量；evidence.py 判定 Phase 4 触发条件",
        ".hil/results/ 与 baseline.json 是派生评测产物，由 .hilignore 排除出索引",
        "记忆片 ≤ budget/4；每个片段行号与磁盘一致；.ai-memory 不作为源码重建索引"
      ]
    }
  ]
